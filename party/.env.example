# Corn Planet Party server configuration. Copy to .env for local development.
# Never commit a real .env file.

PORT=3000
# 0.0.0.0 lets phones on your Wi-Fi reach your dev machine.
HOST=0.0.0.0

# SQLite file for prompts, profiles and stats. Its folder must be on persistent storage in production.
DATABASE_PATH=./data/party.db

# Set to 1 when running behind a reverse proxy / platform load balancer (for correct client IPs).
TRUST_PROXY=0

# Accounts: firebase | dev | none
#   firebase = reuse the CPI Database's Firebase logins (production)
#   dev      = fake local logins for testing only (refused when NODE_ENV=production)
#   none     = guest play only
AUTH_MODE=firebase

# Firebase *web* config. These values are public by design (they already ship in the
# database site's pages); security comes from token verification and Firestore rules.
FIREBASE_PROJECT_ID=cpo-9af17
FIREBASE_API_KEY=AIzaSyBshT0wE2kjCIPpt1BozZvLlY3kGwWEH90
FIREBASE_AUTH_DOMAIN=cpo-9af17.firebaseapp.com

# The CPI Database site, used for the "inspect the record" links games show after a round.
CPI_DATABASE_URL=https://jj2sly.github.io/corn.planet

# My Cob Escaped's Incident Director: builtin (offline templates, free) or claude.
# claude sends each stage (the hidden incident and the agents' responses) to the Claude API and
# needs an Anthropic API key. It falls back to the built-in director on any failure or delay.
MYCOB_DIRECTOR=builtin
# ANTHROPIC_API_KEY=
