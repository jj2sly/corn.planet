rules_version = '2';

// =========================================
// CPI FIRESTORE SECURITY RULES
// Paste into Firebase Console -> Firestore Database -> Rules -> Publish.
//
// This file is the copy of the console rules kept in the repo (taken from the console on
// 2026-09-17). Nothing deploys it: the console is what's live, so keep the two in step by hand.
//
// Helper functions live INSIDE the service/match block on purpose —
// they reference the {database} path variable, which is only in scope
// there. Defining them at the top level (outside the block) silently
// fails to resolve $(database), and Firestore denies-by-default on any
// rule that can't evaluate cleanly — which is what caused the
// "Missing or insufficient permissions" error even for EXEC accounts.
// =========================================

service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'VIEWER';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function roleAtLeast(minLevel) {
      let levels = {
        'VIEWER': 0,
        'CPI_EMPLOYEE': 1,
        'CORRESPONDENT': 2,
        'OVERSEER': 3,
        'EXEC': 4
      };
      return isSignedIn() && levels[getRole()] >= minLevel;
    }

    // ---- Public-facing content: anyone can read, no login required ----
    match /entities/{entityId} {
      allow read: if true;
      allow create, update, delete: if roleAtLeast(2); // CORRESPONDENT+
    }

    match /artifacts/{artifactId} {
      allow read: if true;
      allow create, update, delete: if roleAtLeast(2); // CORRESPONDENT+
    }

    // Added 2026-09-17: incident and personnel files (INC-###, PER-###). World-readable like
    // entities, so the Corn Planet Party server can read canon with no token and guests can play.
    match /incidents/{incidentId} {
      allow read: if true;
      allow create, update, delete: if roleAtLeast(2); // CORRESPONDENT+
    }

    match /personnel/{personnelId} {
      allow read: if true;
      allow create, update, delete: if roleAtLeast(2); // CORRESPONDENT+
    }

    match /classifications/{classId} {
      allow read: if true;
      allow create, update, delete: if roleAtLeast(3); // OVERSEER+
    }

    // ---- User role records ----
    match /users/{uid} {
      // Users can read their own role doc (needed to check their own
      // permissions client-side). EXEC can read all, for the user list.
      allow read: if isSignedIn() && (request.auth.uid == uid || roleAtLeast(4));

      // A user can create their OWN doc on signup, but only ever as
      // VIEWER — they cannot self-promote during creation.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'VIEWER';

      // Only EXEC can change anyone's role.
      allow update: if roleAtLeast(4);

      // No deletes from the client; remove accounts via Firebase Auth
      // console if ever needed.
      allow delete: if false;
    }
  }
}
